-- --- LÓGICA MATEMÁTICA REAL ---
local function SolveMath(str)
    -- Limpiar espacios
    str = str:gsub(" ", "")
    
    -- Soporte para operaciones básicas usando patrones de Lua
    local op, a, b
    if str:find("+") then
        a, b = str:match("(%d+)%+(%d+)")
        if a and b then return tonumber(a) + tonumber(b) end
    elseif str:find("-") then
        a, b = str:match("(%d+)%-(%d+)")
        if a and b then return tonumber(a) - tonumber(b) end
    elseif str:find("*") or str:find("x") then
        a, b = str:match("(%d+)[*xX](%d+)")
        if a and b then return tonumber(a) * tonumber(b) end
    elseif str:find("/") then
        a, b = str:match("(%d+)/(%d+)")
        if a and b then return tonumber(a) / tonumber(b) end
    end
    return nil
end

