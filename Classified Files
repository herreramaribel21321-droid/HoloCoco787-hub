local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "HOLOCOCO787 🧊 V28 - SURVIVE IN AFRICA",
   LoadingTitle = "CARGANDO HUB MULTI-JUEGO...",
   LoadingSubtitle = "by HoloCoco787",
   ConfigurationSaving = { Enabled = false },
   Theme = "Ocean", 
})

-- NOTA INFORMATIVA
Rayfield:Notify({
   Title = "INFO DEL SCRIPT",
   Content = "Optimizado para Survive In Africa. (Utilidades compatibles con la mayoría de juegos)",
   Duration = 7
})

-- PESTAÑAS
local TabFarm = Window:CreateTab("Farm & Red", 4483362458)
local TabPlayer = Window:CreateTab("Jugador", 4483362458)
local TabUtil = Window:CreateTab("Sistema", 4483362458)
local TabRender = Window:CreateTab("Rendimiento", 4483362458)

local player = game.Players.LocalPlayer
local pGui = player:WaitForChild("PlayerGui")
local VirtualUser = game:GetService("VirtualUser")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Camera = workspace.CurrentCamera

-- VARIABLES
_G.autoWork = false
_G.noclip = false
_G.antiAFK = false
_G.infJump = false
_G.espEnabled = false
_G.targetSpeed = 16

--- [ PESTAÑA: FARM & RED ] ---
TabFarm:CreateSection("--- MONITOR DE RED ---")
local PingLabel = TabFarm:CreateLabel("📡 Ping: midiendo...")

task.spawn(function()
    while true do
        local ping = tonumber(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValueString():match("%d+"))
        PingLabel:Set("📡 Ping: " .. ping .. "ms")
        task.wait(1)
    end
end)

TabFarm:CreateSection("--- AUTO-ACCIONES ---")
TabFarm:CreateToggle({
   Name = "AUTO-FARM (Work & Sell) 💰",
   CurrentValue = false,
   Callback = function(Value)
      _G.autoWork = Value
      task.spawn(function()
         while _G.autoWork do
            pcall(function()
                if pGui:FindFirstChild("SugarGui") then
                   pGui.SugarGui.Enabled = true
                   local btn = pGui.SugarGui:FindFirstChild("Work", true) or pGui.SugarGui:FindFirstChildOfClass("TextButton")
                   if btn then btn:Activate() end
                end
                for _, p in pairs(workspace:GetDescendants()) do
                    if p:IsA("ProximityPrompt") and (p.ObjectText == "Deliver the cargo" or p.ActionText:find("Deliver")) then
                        p.HoldDuration = 0
                        fireproximityprompt(p)
                    end
                end
            end)
            task.wait(0.1) 
         end
      end)
   end,
})

-- NUEVO BOTÓN SOLICITADO
TabFarm:CreateButton({
   Name = "PROXIMITY INSTANTÁNEO ⚡",
   Callback = function()
      task.spawn(function()
          while task.wait(0.5) do
              for _, v in pairs(game:GetDescendants()) do
                  if v:IsA("ProximityPrompt") then
                      v.HoldDuration = 0
                  end
              end
          end
      end)
      Rayfield:Notify({Title = "Activado", Content = "Ahora todas las interacciones son instantáneas", Duration = 3})
   end,
})

--- [ PESTAÑA: JUGADOR ] ---
TabPlayer:CreateSection("Movimiento y Cámara")

TabPlayer:CreateSlider({
   Name = "CAMPO DE VISIÓN (FOV) 👁️",
   Range = {70, 120},
   Increment = 1,
   Suffix = "Deg",
   CurrentValue = 70,
   Callback = function(Value)
      Camera.FieldOfView = Value
   end,
})

TabPlayer:CreateButton({ Name = "VELOCIDAD TURBO (80) 🚀", Callback = function() _G.targetSpeed = 80 end })
TabPlayer:CreateButton({ Name = "VELOCIDAD NORMAL (16) 🔄", Callback = function() _G.targetSpeed = 16 end })

--- [ PESTAÑA: SISTEMA ] ---
TabUtil:CreateSection("Habilidades Globales")

TabUtil:CreateToggle({
   Name = "NOCLIP (Atravesar Paredes) 👻",
   CurrentValue = false,
   Callback = function(Value)
      _G.noclip = Value
   end,
})

TabUtil:CreateToggle({
   Name = "ESP JUGADORES (Visión Rayos X) 👁️",
   CurrentValue = false,
   Callback = function(Value)
      _G.espEnabled = Value
      if Value then
         for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= player and p.Character then
               local h = Instance.new("Highlight", p.Character)
               h.Name = "ESPHighlight"
               h.FillColor = Color3.fromRGB(0, 255, 255)
               h.FillTransparency = 0.5
            end
         end
      else
         for _, p in pairs(game.Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("ESPHighlight") then
               p.Character.ESPHighlight:Destroy()
            end
         end
      end
   end,
})

TabUtil:CreateToggle({ Name = "SALTO INFINITO ☁️", CurrentValue = false, Callback = function(Value) _G.infJump = Value end })

TabUtil:CreateSection("Seguridad en Africa")

TabUtil:CreateButton({
   Name = "TP: CIELO SEGURO (ZONA ANTIBAN) ☁️",
   Callback = function()
      if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
          player.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 1000, 0)
          Rayfield:Notify({Title = "Teleport", Content = "Puesto a salvo en las alturas.", Duration = 2})
      end
   end,
})

TabUtil:CreateToggle({ Name = "ANTI-AFK (Modo 24/7) 🛡️", CurrentValue = false, Callback = function(Value) _G.antiAFK = Value end })

TabUtil:CreateButton({
   Name = "REJOIN (Reconectar Server) 🔄",
   Callback = function()
       game:GetService("TeleportService"):Teleport(game.PlaceId, player)
   end,
})

--- [ PESTAÑA: RENDIMIENTO ] ---
TabRender:CreateButton({
   Name = "MODO FPS (Eliminar Lag) ⚡",
   Callback = function()
       for _, v in pairs(game:GetDescendants()) do
           if v:IsA("Part") or v:IsA("UnionOperation") or v:IsA("MeshPart") then
               v.Material = Enum.Material.Plastic
               v.Reflectance = 0
           elseif v:IsA("ParticleEmitter") or v:IsA("Decal") then
               v.Enabled = false
           end
       end
       Lighting.GlobalShadows = false
       Rayfield:Notify({Title = "HoloCoco Tech", Content = "Optimización aplicada con éxito.", Duration = 3})
   end,
})

-- LÓGICA DE FONDO
RunService.Stepped:Connect(function()
    pcall(function()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = _G.targetSpeed
            
            if _G.infJump and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                player.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            
            if _G.noclip then
                for _, v in pairs(player.Character:GetDescendants()) do
                    if v:IsA("BasePart") then v.CanCollide = false end
                end
            end
        end
    end)
end)

player.Idled:Connect(function()
    if _G.antiAFK then
        VirtualUser:Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(1); VirtualUser:Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end
end)

Rayfield:Notify({Title = "HOLOCOCO787 V28", Content = "¡Bienvenido a Survive In Africa!", Duration = 5})
