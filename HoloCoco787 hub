-- --- FUNCIÓN OPTIMIZADA (SIN LAG) PARA TRAER MONEDAS ---
local function bringDabloonsOptimized()
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local items = {}
        
        -- Primero recolectamos las referencias para no saturar el loop
        for _, obj in pairs(game.Workspace:GetDescendants()) do
            if obj.Name == "Dabloon" and obj:IsA("BasePart") then
                table.insert(items, obj)
            end
        end
        
        -- Movemos las monedas de forma escalonada para evitar lag
        for i, item in ipairs(items) do
            if item and item.Parent then
                item.CFrame = hrp.CFrame
                -- Pausa mínima cada 5 monedas para dejar que el juego respire
                if i % 5 == 0 then
                    task.wait() 
                end
            end
        end
    end
end

-- Creación de Botones
local function createBtn(btn, text, pos)
    btn.Parent = MainFrame
    btn.Text = text
    btn.Position = pos
    btn.Size = UDim2.new(0.8, 0, 0, 35)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.Gotham
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
end

createBtn(BringDabloonBtn, "Traer Dabloons", UDim2.new(0.1, 0, 0.25, 0))
createBtn(SpeedBtn, "Velocidad: 55", UDim2.new(0.1, 0, 0.45, 0))
createBtn(JumpBtn, "Salto Infinito", UDim2.new(0.1, 0, 0.65, 0))

BringDabloonBtn.MouseButton1Click:Connect(bringDabloonsOptimized)

SpeedBtn.MouseButton1Click:Connect(function() 
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = 55
    end 
end)

local infJump = false
JumpBtn.MouseButton1Click:Connect(function()
    infJump = not infJump
    JumpBtn.TextColor3 = infJump and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 255, 255)
end)

game:GetService("UserInputService").JumpRequest:Connect(function()
    if infJump and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState("Jumping") end
    end
end)

-- Efecto RGB Neon (Loop suave)
task.spawn(function()
    while task.wait(0.05) do
        if not Library or not Library.Parent then break end
        local hue = tick() % 5 / 5
        local color = Color3.fromHSV(hue, 1, 1)
        UIStroke.Color = color
        UIStrokeCircle.Color = color
        Title.TextColor3 = color
        OpenBtn.TextColor3 = color
    end
end)
